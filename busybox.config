CONFIG_STATIC=y
CONFIG_EXTRA_CFLAGS="-march=rv64gc -mabi=lp64d"
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_BUSYBOX=y
CONFIG_BUSYBOX_EXEC_PATH="/busybox"
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_ECHO=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_TOUCH=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y
